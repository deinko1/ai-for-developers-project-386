#!/bin/sh
# Enforce Conventional Commits (https://www.conventionalcommits.org/).
# Bypass with: git commit --no-verify
set -e

# git runs hooks without the interactive shell's PATH, so put mise (and thus
# Node) on PATH explicitly, like the Makefile does.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

root="$(git rev-parse --show-toplevel)"
bin="$root/node_modules/.bin/commitlint"

if [ ! -x "$bin" ]; then
  echo "commit-msg: commitlint not found. Run 'make install' (or 'make commitlint-install')." >&2
  exit 1
fi

exec mise exec -- node "$bin" --edit "$1"
